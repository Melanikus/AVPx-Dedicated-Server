(* Handshake A of CRYPTO.md: a game and its relay, pattern pqNK, hybrid (ECDH P-384 and ML-KEM-1024), as a ProVerif model. Written
   2026-11-09 by Melanikus for AVPx Dedicated Server.

   ProVerif (INRIA, bblanche.gitlabpages.inria.fr/proverif) proves things about a protocol against an attacker who controls the whole
   network: it reads, drops, changes and makes up every message. It proves them about the pattern, not about our code: the code is held
   to the pattern by the test vectors (CRYPTO.md section 15) and the tests.

   WHAT IS MODELLED, step for step as CRYPTO.md sections 5 and 5.1 write it:
   - h starts as the hash of the protocol's name, and ck as h; then MixHash(the prologue: the region and a 0 byte), then the
     pre-message "<- s": MixHash(the relay's static P-384 key), then MixHash(its static ML-KEM key) (5.1, points 4 and 5);
   - A1, game to relay: e (MixHash of the ephemeral P-384 key, then of the ephemeral ML-KEM key), es, skem, and an empty
     EncryptAndHash;
   - A2, relay to game: e, ee, ekem, and EncryptAndHash(the relay's session id);
   - A3, game to relay: an empty EncryptAndHash, the game's key confirmation;
   - Split: one key each way. The game then sends a control message sealed with its key, holding a secret.
   - MixKey is HKDF: here two functions of (ck, the secret) that give the next ck and the next k. They're one-way and have no other
     property, which is what HKDF-SHA-384 is taken to be.
   - ECDH is Diffie-Hellman: exp(exp(g, x), y) = exp(exp(g, y), x).
   - ML-KEM is an ideal KEM: decapsulating an encapsulation with the right secret key gives its shared secret, and nothing else does.
   - AES-256-GCM is ideal authenticated encryption: it opens only with its key, nonce and associated data (here, h).
   - The nonces are the constants n0 and n1: within one k the counter goes 0 then 1, and every MixKey makes a new k (section 5).

   WHAT IS NOT MODELLED, and why:
   - the cookie round (A0, A0'): it guards against floods from forged addresses, not secrecy or authentication; the code's tests hold it;
   - the counters and the replay window of the sealed messages after the handshake: ProVerif doesn't count; the tests hold them;
   - fragments: they carry bytes, and change nothing a proof is about;
   - the game proving itself to the relay: pqNK doesn't, by design (the game is anonymous; its tokens and tickets, inside the channel,
     are what prove a host or joiner);
   - the relay taking the game's first sealed message in place of an A3 that was lost (CRYPTO.md section 6, "Losses"): no query here is
     about what the relay agrees to, because the game is anonymous, so it changes no answer.

   THE QUERIES (proofs/run.sh runs them, and says what each must give):
   1. secrecy: the attacker never learns what an honest game sends under its session key, even when the relay's static keys are given
      away after the sessions end (phase 1 below), which is forward secrecy;
   2. the relay's authentication and transcript agreement, injective: whenever a game finishes a handshake, a real relay, one holding the
      static keys, derived the same two keys over the same transcript, in a session of its own; and each such relay session answers
      only one game session, so a replayed handshake can't be taken twice.

   The lines marked LEAKDH and LEAKKEM are comments here. proofs/run.sh makes copies with them switched on, giving the attacker every ECDH
   secret, or every ML-KEM secret, or both, to show that either half of the hybrid alone keeps both queries true, and that with both
   broken they fail (so the model isn't trivially true). *)

free c: channel.

(* The bytes everyone knows *)
const protoname: bitstring.
const region: bitstring.
const empty: bitstring.

(* Diffie-Hellman on P-384 *)
type G.
type exponent.
const g: G [data].
fun exp(G, exponent): G.
equation forall x: exponent, y: exponent; exp(exp(g, x), y) = exp(exp(g, y), x).
fun G2b(G): bitstring [typeConverter].

(* ML-KEM-1024, an ideal KEM *)
type kemsk.
type kempk.
type coins.
fun kemPub(kemsk): kempk.
fun kemct(kempk, coins): bitstring.
fun kemss(kempk, coins): bitstring.
reduc forall sk: kemsk, r: coins; kemdec(sk, kemct(kemPub(sk), r)) = kemss(kemPub(sk), r).
fun kempk2b(kempk): bitstring [typeConverter].

(* SHA-384 for MixHash, and HKDF-SHA-384 for MixKey and Split, as one-way functions *)
type key.
fun hash0(bitstring): bitstring.
fun hash(bitstring, bitstring): bitstring.
fun kdfck(bitstring, bitstring): bitstring.
fun kdfk(bitstring, bitstring): key.
fun splitir(bitstring): key.
fun splitri(bitstring): key.

(* AES-256-GCM, ideal authenticated encryption with associated data *)
type nonce.
const n0: nonce.
const n1: nonce.
fun aenc(key, nonce, bitstring, bitstring): bitstring.
reduc forall k: key, n: nonce, ad: bitstring, m: bitstring; adec(k, n, ad, aenc(k, n, ad, m)) = m.

(* What an honest game sends under its session key, which must stay secret *)
free secretI: bitstring [private].

(* The game has finished its handshake with the relay whose static P-384 key is the first argument, over the transcript h, with the two
   keys k_ir and k_ri; and the relay has derived those keys over that transcript. The h here is h10, before A3's tag; CRYPTO.md 5.1 point
   15 calls h after A3 "the transcript". They come to the same: h11 is the hash of h10 and A3's tag, which is made under k4 from h10, so
   agreeing on h10 and the keys is agreeing on h11. *)
event IDone(G, bitstring, key, key).
event RKeys(G, bitstring, key, key).

query attacker(secretI).
query s: G, h: bitstring, kir: key, kri: key; inj-event(IDone(s, h, kir, kri)) ==> inj-event(RKeys(s, h, kir, kri)).

(* The game: knows the relay's static keys (from the signed directory) before it says anything *)
let Initiator(sdhPub: G, skemPub: kempk) =
  new e: exponent;
  new ek: kemsk;
  new r1: coins;
  let h0 = hash0(protoname) in
  let ck0 = h0 in
  let h1 = hash(h0, region) in
  let h2 = hash(h1, G2b(sdhPub)) in
  let h3 = hash(h2, kempk2b(skemPub)) in
  (* A1: e *)
  let epub = exp(g, e) in
  let h4 = hash(h3, G2b(epub)) in
  let h5 = hash(h4, kempk2b(kemPub(ek))) in
  (* es *)
  let dhes = G2b(exp(sdhPub, e)) in
  (*LEAKDH out(c, dhes); LEAKDH*)
  let ck1 = kdfck(ck0, dhes) in
  (* skem *)
  let ct1 = kemct(skemPub, r1) in
  let h6 = hash(h5, ct1) in
  let ss1 = kemss(skemPub, r1) in
  (*LEAKKEM out(c, ss1); LEAKKEM*)
  let ck2 = kdfck(ck1, ss1) in
  let k2 = kdfk(ck1, ss1) in
  let a1tag = aenc(k2, n0, h6, empty) in
  let h7 = hash(h6, a1tag) in
  out(c, (epub, kemPub(ek), ct1, a1tag));
  (* A2 *)
  in(c, (repub: G, ct2: bitstring, a2: bitstring));
  let h8 = hash(h7, G2b(repub)) in
  let dhee = G2b(exp(repub, e)) in
  (*LEAKDH out(c, dhee); LEAKDH*)
  let ck3 = kdfck(ck2, dhee) in
  let h9 = hash(h8, ct2) in
  let ss2 = kemdec(ek, ct2) in
  (*LEAKKEM out(c, ss2); LEAKKEM*)
  let ck4 = kdfck(ck3, ss2) in
  let k4 = kdfk(ck3, ss2) in
  let sid = adec(k4, n0, h9, a2) in
  let h10 = hash(h9, a2) in
  (* A3, and Split *)
  let a3tag = aenc(k4, n1, h10, empty) in
  let kir = splitir(ck4) in
  let kri = splitri(ck4) in
  event IDone(sdhPub, h10, kir, kri);
  out(c, a3tag);
  (* A sealed control message, holding what must stay secret *)
  out(c, aenc(kir, n0, empty, secretI)).

(* The relay: holds its static keys *)
let Responder(sdh: exponent, skem: kemsk) =
  let sdhPub = exp(g, sdh) in
  let skemPub = kemPub(skem) in
  in(c, (epub: G, ekPub: kempk, ct1: bitstring, a1tag: bitstring));
  let h0 = hash0(protoname) in
  let ck0 = h0 in
  let h1 = hash(h0, region) in
  let h2 = hash(h1, G2b(sdhPub)) in
  let h3 = hash(h2, kempk2b(skemPub)) in
  let h4 = hash(h3, G2b(epub)) in
  let h5 = hash(h4, kempk2b(ekPub)) in
  let dhes = G2b(exp(epub, sdh)) in
  let ck1 = kdfck(ck0, dhes) in
  let h6 = hash(h5, ct1) in
  let ss1 = kemdec(skem, ct1) in
  let ck2 = kdfck(ck1, ss1) in
  let k2 = kdfk(ck1, ss1) in
  let m1 = adec(k2, n0, h6, a1tag) in
  if m1 = empty then
  let h7 = hash(h6, a1tag) in
  (* A2: e, ee, ekem, and the session id *)
  new re: exponent;
  new r2: coins;
  new sid: bitstring;
  let repub = exp(g, re) in
  let h8 = hash(h7, G2b(repub)) in
  let dhee = G2b(exp(epub, re)) in
  let ck3 = kdfck(ck2, dhee) in
  let ct2 = kemct(ekPub, r2) in
  let h9 = hash(h8, ct2) in
  let ss2 = kemss(ekPub, r2) in
  let ck4 = kdfck(ck3, ss2) in
  let k4 = kdfk(ck3, ss2) in
  let a2 = aenc(k4, n0, h9, sid) in
  let h10 = hash(h9, a2) in
  let kir = splitir(ck4) in
  let kri = splitri(ck4) in
  event RKeys(sdhPub, h10, kir, kri);
  out(c, (repub, ct2, a2));
  (* A3: the game's key confirmation; then its sealed messages *)
  in(c, a3tag: bitstring);
  let m3 = adec(k4, n1, h10, a3tag) in
  if m3 = empty then
  in(c, sealed: bitstring);
  let msg = adec(kir, n0, empty, sealed) in
  0.

process
  new sdh: exponent;
  new skem: kemsk;
  out(c, (exp(g, sdh), kemPub(skem)));
  (
    (! Initiator(exp(g, sdh), kemPub(skem)))
  | (! Responder(sdh, skem))
  | (phase 1; out(c, (sdh, skem)))
  )
