# The Java version of the server as a systemd service on Ubuntu LTS. Written 2026-11-09 by Melanikus for AVPx Dedicated Server, from
# avpx.service (the Node version's), with everything it keeps the server from kept the same.
#
# It runs as its own user, avpx, which owns nothing but its settings, and can't log in. The only right it's given beyond an ordinary
# user's is to listen on a port below 1024 (443, for HTTPS). It can't raise its rights, can't write anywhere on the machine, can't see
# other users' files or other processes, and starts again by itself if it stops. Its log goes to the system journal (journalctl -u
# avpx-java), which holds no addresses: the server never writes one.
#
# It reads the same settings file as the Node version, /etc/avpx/settings.json, always that one: the Java version takes no path when it
# starts. Run one version or the other on a machine, never both: they'd want the same ports.
#
# The JDK is the one java/tools/get-jdk.sh fetched and checked (its signature, its sha256 and its version) into /opt/avpx-jdk, the very
# JDK the tests ran on: deploy/README.md, "The Java version". Install: copy to /etc/systemd/system/avpx-java.service, then
# `systemctl daemon-reload` and `systemctl enable --now avpx-java`. Nothing here has been run on a real machine yet.

[Unit]
Description=AVPx Dedicated Server, the Java version (the game list and the relay)
After=network-online.target
Wants=network-online.target
# Never give up starting it again. systemd's own default stops trying after 5 starts in 10 s and leaves the service dead. RestartSec=5,
# below, already keeps it under that, but a server that stops itself on an error nobody expected (java/src/avpx/Fatal.java, the
# independent review's V1-3) must always come back, so the limit is said here, plainly, as none. A server failing again and again then
# starts once every 5 s, each time with a line in the journal saying why.
StartLimitIntervalSec=0

[Service]
Type=simple
User=avpx
Group=avpx
WorkingDirectory=/opt/avpx/current

# -XX:+ExitOnOutOfMemoryError: a server out of memory stops, and systemd starts it afresh, rather than limping on half-working.
# -XX:+DisableAttachMechanism: no other program on the machine can attach to the running Java and change what it does.
# -Xmx256m: the most memory Java may use for its objects, well inside MemoryMax below, so the machine's limit is never what stops it.
ExecStart=/opt/avpx-jdk/bin/java -XX:+ExitOnOutOfMemoryError -XX:+DisableAttachMechanism -Xmx256m -jar /opt/avpx/current/avpx-server.jar
# on-failure: started again after any exit but 0 (Fatal's 1 and Java's out-of-memory exit among them) and after being killed by a signal.
# 0 is a stop that was asked for (systemctl stop), and is left stopped.
Restart=on-failure
RestartSec=5

# The one right beyond an ordinary user's: to listen on 443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# What it may see and touch: nothing it doesn't need
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
RestrictAddressFamilies=AF_INET AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Not here, on purpose, as for the Node version: ProcSubset=pid (Java reads /proc to learn its machine's processors and memory),
# MemoryDenyWriteExecute (Java's compiler writes code it runs), and ~@resources (not proven safe for Java). Each can be added once the
# machine shows Java starts with it.

# Its settings and certificate are read only; it writes nothing on the disk (its log goes to the journal)
ReadOnlyPaths=/etc/avpx /opt/avpx /opt/avpx-jdk

# Limits on what it can use, so a fault can't take the machine. Java runs more threads of its own than Node (its compilers, its garbage
# collector, one for each processor for the list's connections), hence more tasks than the Node version's 64.
LimitNOFILE=8192
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
