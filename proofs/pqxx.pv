(* Handshake B of CRYPTO.md: a joiner and its host, end to end, pattern pqXX, hybrid (ECDH P-384 and ML-KEM-1024), as a ProVerif model.
   Written 2026-11-09 by Melanikus for AVPx Dedicated Server.

   The same building blocks as proofs/pqnk.pv (its header says how each is modelled, and why), and the same attacker, who controls the
   whole network, the relay included: the relay only ever forwards these messages, and here it's simply part of the network.

   WHAT IS MODELLED, as CRYPTO.md section 8 writes it:
   - each player has an identity: a static P-384 key and a static ML-KEM key. Its fingerprint is a hash of both;
   - the prologue: the region and a 0 byte, the joiner's relay port, and the host's fingerprint as the listing gives it (5.1 point 17);
   - B1, joiner to host: e (MixHash of the ephemeral P-384 key, then of the ephemeral ML-KEM key), then the joiner's commitment to its
     32 bytes for the check code, MixHashed (5.1 point 19);
   - B2, host to joiner: e, ee, ekem, s (the host's static keys, sealed), es, and an empty EncryptAndHash;
   - B3, joiner to host: skem (to the host's static ML-KEM key), s (the joiner's static keys, sealed), se, and an empty EncryptAndHash;
   - B4, host to joiner: skem (to the joiner's static ML-KEM key), and an EncryptAndHash of the host's 32 bytes for the check code: the
     host's key confirmation;
   - B5, joiner to host: an EncryptAndHash of the joiner's 32 bytes, which the host checks against B1's commitment: the joiner's key
     confirmation, after B4's skem;
   - Split, then each side sends a sealed game datagram holding a secret.
     (Split gives each direction a secret, and epoch 0's key is made from it: 5.1 points 3 and 8. The model makes those two one-way
     steps one, splitir and splitri, because a one-way function of a one-way function is the same to the attacker here.)
   The joiner takes the host only if the fingerprint of the static keys in B2 is the one the listing gave. The host takes any joiner (in
   the game, anyone may join), and what's proved is about a joiner whose identity it knows.

   NOT MODELLED: the six-digit check code itself (it's for people to compare, and it's what catches a list that lies about the
   fingerprint; here the listing is honest). Its commitment and its two values travel here as they do on the wire, but no query is
   about the code: why the commitment stops anyone grinding it is argued in CRYPTO.md 5.1 point 19. Also counters, windows, fragments.

   THE QUERIES (proofs/run.sh says what each must give):
   1. the joiner's secret stays secret; 2. the host's secret stays secret: both even when every static key is given away after the
      sessions end (phase 1), which is forward secrecy;
   3. the host's authentication to the joiner, injective: a joiner that finishes did so with the real host, which derived the same keys
      over the same transcript;
   4. the joiner's authentication to the host, injective: when the host finishes with the honest joiner's identity, that joiner derived
      the same keys over the same transcript.
   The LEAKDH and LEAKKEM lines are comments here; proofs/run.sh switches them on in copies. A broken half gives the attacker its
   secrets, each as it's made: every ECDH exponent, static and ephemeral, or every ML-KEM secret key and every encapsulation's coins
   (proofs/README.md). *)

free c: channel.

const protoname: bitstring.
const region: bitstring.
const relayport: bitstring.
const empty: bitstring.

type G.
type exponent.
const g: G [data].
fun exp(G, exponent): G.
equation forall x: exponent, y: exponent; exp(exp(g, x), y) = exp(exp(g, y), x).
fun G2b(G): bitstring [typeConverter].

type kemsk.
type kempk.
type coins.
fun kemPub(kemsk): kempk.
fun kemct(kempk, coins): bitstring.
fun kemss(kempk, coins): bitstring.
reduc forall sk: kemsk, r: coins; kemdec(sk, kemct(kemPub(sk), r)) = kemss(kemPub(sk), r).
fun kempk2b(kempk): bitstring [typeConverter].

type key.
fun hash0(bitstring): bitstring.
fun hash(bitstring, bitstring): bitstring.
fun kdfck(bitstring, bitstring): bitstring.
fun kdfk(bitstring, bitstring): key.
fun splitir(bitstring): key.
fun splitri(bitstring): key.
fun fp(G, kempk): bitstring.
(* The joiner's commitment to its 32 bytes for the check code: SHA-384, as a hash of its own *)
fun commit(bitstring): bitstring.

type nonce.
const n0: nonce.
const n1: nonce.
fun aenc(key, nonce, bitstring, bitstring): bitstring.
reduc forall k: key, n: nonce, ad: bitstring, m: bitstring; adec(k, n, ad, aenc(k, n, ad, m)) = m.

free secretJ: bitstring [private].
free secretH: bitstring [private].

(* Arguments: the host's static P-384 key, the joiner's static P-384 key, the transcript, and the two keys. The h here is h10, before
   B5's tag; CRYPTO.md 5.1 point 15 calls h after B5 "the transcript". They come to the same: h after B5 is the hash of h10 and B5's tag,
   which is made under k6 from h10. *)
event JDone(G, G, bitstring, key, key).
event HKeys(G, G, bitstring, key, key).
event HDone(G, G, bitstring, key, key).
event JKeys(G, G, bitstring, key, key).

query attacker(secretJ).
query attacker(secretH).
query sh: G, sj: G, h: bitstring, kir: key, kri: key; inj-event(JDone(sh, sj, h, kir, kri)) ==> inj-event(HKeys(sh, sj, h, kir, kri)).
query sh: G, sj: G, h: bitstring, kir: key, kri: key; inj-event(HDone(sh, sj, h, kir, kri)) ==> inj-event(JKeys(sh, sj, h, kir, kri)).

(* The joiner, with its identity, and the host's fingerprint as the listing gives it *)
let Joiner(jdh: exponent, jkem: kemsk, hostfp: bitstring) =
  let jdhPub = exp(g, jdh) in
  let jkemPub = kemPub(jkem) in
  new e: exponent;
  (*LEAKDH out(c, e); LEAKDH*)
  new ek: kemsk;
  (*LEAKKEM out(c, ek); LEAKKEM*)
  new r3: coins;
  (*LEAKKEM out(c, r3); LEAKKEM*)
  new nj: bitstring;
  let h0 = hash0(protoname) in
  let ck0 = h0 in
  let hp = hash(hash(hash(h0, region), relayport), hostfp) in
  (* B1: e *)
  let epub = exp(g, e) in
  let h1 = hash(hash(hash(hp, G2b(epub)), kempk2b(kemPub(ek))), commit(nj)) in
  out(c, (epub, kemPub(ek), commit(nj)));
  (* B2: e, ee, ekem, s, es *)
  in(c, (hepub: G, ct2: bitstring, sealedS: bitstring, b2tag: bitstring));
  let h2 = hash(h1, G2b(hepub)) in
  let dhee = G2b(exp(hepub, e)) in
  let ck1 = kdfck(ck0, dhee) in
  let h3 = hash(h2, ct2) in
  let ss2 = kemdec(ek, ct2) in
  let ck2 = kdfck(ck1, ss2) in
  let k2 = kdfk(ck1, ss2) in
  let (hsdh: G, hskem: kempk) = adec(k2, n0, h3, sealedS) in
  let h4 = hash(h3, sealedS) in
  if fp(hsdh, hskem) = hostfp then
  let dhes = G2b(exp(hsdh, e)) in
  let ck3 = kdfck(ck2, dhes) in
  let k3 = kdfk(ck2, dhes) in
  let m2 = adec(k3, n0, h4, b2tag) in
  if m2 = empty then
  let h5 = hash(h4, b2tag) in
  (* B3: skem, s, se *)
  let ct3 = kemct(hskem, r3) in
  let h6 = hash(h5, ct3) in
  let ss3 = kemss(hskem, r3) in
  let ck4 = kdfck(ck3, ss3) in
  let k4 = kdfk(ck3, ss3) in
  let sealedJ = aenc(k4, n0, h6, (jdhPub, jkemPub)) in
  let h7 = hash(h6, sealedJ) in
  let dhse = G2b(exp(hepub, jdh)) in
  let ck5 = kdfck(ck4, dhse) in
  let k5 = kdfk(ck4, dhse) in
  let b3tag = aenc(k5, n0, h7, empty) in
  let h8 = hash(h7, b3tag) in
  out(c, (ct3, sealedJ, b3tag));
  (* B4: skem to the joiner's static key, and the host's confirmation *)
  in(c, (ct4: bitstring, b4tag: bitstring));
  let h9 = hash(h8, ct4) in
  let ss4 = kemdec(jkem, ct4) in
  let ck6 = kdfck(ck5, ss4) in
  let k6 = kdfk(ck5, ss4) in
  let nh = adec(k6, n0, h9, b4tag) in
  let h10 = hash(h9, b4tag) in
  (* B5, and Split *)
  let b5tag = aenc(k6, n1, h10, nj) in
  let kir = splitir(ck6) in
  let kri = splitri(ck6) in
  event JKeys(hsdh, jdhPub, h10, kir, kri);
  event JDone(hsdh, jdhPub, h10, kir, kri);
  out(c, b5tag);
  out(c, aenc(kir, n0, empty, secretJ)).

(* The host, with its identity; it takes any joiner, and knows the honest joiner's static P-384 key *)
let Host(hdh: exponent, hkem: kemsk, honestJ: G) =
  let hdhPub = exp(g, hdh) in
  let hkemPub = kemPub(hkem) in
  let hostfp = fp(hdhPub, hkemPub) in
  in(c, (epub: G, ekPub: kempk, cj: bitstring));
  let h0 = hash0(protoname) in
  let ck0 = h0 in
  let hp = hash(hash(hash(h0, region), relayport), hostfp) in
  let h1 = hash(hash(hash(hp, G2b(epub)), kempk2b(ekPub)), cj) in
  (* B2 *)
  new he: exponent;
  (*LEAKDH out(c, he); LEAKDH*)
  new r2: coins;
  (*LEAKKEM out(c, r2); LEAKKEM*)
  let hepub = exp(g, he) in
  let h2 = hash(h1, G2b(hepub)) in
  let dhee = G2b(exp(epub, he)) in
  let ck1 = kdfck(ck0, dhee) in
  let ct2 = kemct(ekPub, r2) in
  let h3 = hash(h2, ct2) in
  let ss2 = kemss(ekPub, r2) in
  let ck2 = kdfck(ck1, ss2) in
  let k2 = kdfk(ck1, ss2) in
  let sealedS = aenc(k2, n0, h3, (hdhPub, hkemPub)) in
  let h4 = hash(h3, sealedS) in
  let dhes = G2b(exp(epub, hdh)) in
  let ck3 = kdfck(ck2, dhes) in
  let k3 = kdfk(ck2, dhes) in
  let b2tag = aenc(k3, n0, h4, empty) in
  let h5 = hash(h4, b2tag) in
  out(c, (hepub, ct2, sealedS, b2tag));
  (* B3 *)
  in(c, (ct3: bitstring, sealedJ: bitstring, b3tag: bitstring));
  let h6 = hash(h5, ct3) in
  let ss3 = kemdec(hkem, ct3) in
  let ck4 = kdfck(ck3, ss3) in
  let k4 = kdfk(ck3, ss3) in
  let (jdhPub: G, jkemPub: kempk) = adec(k4, n0, h6, sealedJ) in
  let h7 = hash(h6, sealedJ) in
  let dhse = G2b(exp(jdhPub, he)) in
  let ck5 = kdfck(ck4, dhse) in
  let k5 = kdfk(ck4, dhse) in
  let m3 = adec(k5, n0, h7, b3tag) in
  if m3 = empty then
  let h8 = hash(h7, b3tag) in
  (* B4: skem to the joiner's static key, and the host's confirmation *)
  new r4: coins;
  (*LEAKKEM out(c, r4); LEAKKEM*)
  new nh: bitstring;
  let ct4 = kemct(jkemPub, r4) in
  let h9 = hash(h8, ct4) in
  let ss4 = kemss(jkemPub, r4) in
  let ck6 = kdfck(ck5, ss4) in
  let k6 = kdfk(ck5, ss4) in
  let b4tag = aenc(k6, n0, h9, nh) in
  let h10 = hash(h9, b4tag) in
  let kir = splitir(ck6) in
  let kri = splitri(ck6) in
  event HKeys(hdhPub, jdhPub, h10, kir, kri);
  out(c, (ct4, b4tag));
  (* B5: the joiner's confirmation *)
  in(c, b5tag: bitstring);
  let nj = adec(k6, n1, h10, b5tag) in
  if commit(nj) = cj then
  if jdhPub = honestJ then
  event HDone(hdhPub, jdhPub, h10, kir, kri);
  out(c, aenc(kri, n0, empty, secretH)).

process
  new hdh: exponent;
  (*LEAKDH out(c, hdh); LEAKDH*)
  new hkem: kemsk;
  (*LEAKKEM out(c, hkem); LEAKKEM*)
  new jdh: exponent;
  (*LEAKDH out(c, jdh); LEAKDH*)
  new jkem: kemsk;
  (*LEAKKEM out(c, jkem); LEAKKEM*)
  out(c, (exp(g, hdh), kemPub(hkem), exp(g, jdh), kemPub(jkem)));
  (
    (! Joiner(jdh, jkem, fp(exp(g, hdh), kemPub(hkem))))
  | (! Host(hdh, hkem, exp(g, jdh)))
  | (phase 1; out(c, (hdh, hkem, jdh, jkem)))
  )
